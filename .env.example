# RupChorcha Backend Environment Variables
# Copy this file to .env and fill in real values locally. Never commit .env.

# --- Server & CORS (Part A) ---
PORT=5000
NODE_ENV=development
# Comma-separated allowed browser origins (e.g. Next.js client URL)
CLIENT_URL=http://localhost:3000

# --- MongoDB (Part A) ---
# Note: legacy DB_URI is also supported as a fallback during migration.
MONGODB_URI=
MONGODB_DB_NAME=rup-chorcha

# --- Better Auth & JWT (Part B) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
JWT_SECRET=
JWT_EXPIRES_IN=15m
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Stripe Payments (Phase 5) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# --- ImgBB Image Hosting (Phase 2) ---
IMGBB_API_KEY=
MAX_UPLOAD_MB=5
