# RupChorcha Backend Environment Variables
# Copy this file to .env and fill in real values locally. Never commit .env.

# --- Server & CORS (Part A) ---
PORT=5000
NODE_ENV=development
# Comma-separated allowed browser origins (e.g. Next.js client URL)
CLIENT_URL=http://localhost:3000

# --- MongoDB (Part A) ---
# Note: legacy DB_URI is also supported as a fallback during migration.
MONGODB_URI=
MONGODB_DB_NAME=rup-chorcha

# --- Better Auth & JWT (Part B) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=rup-chorcha-api
JWT_AUDIENCE=rup-chorcha-client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=RupChorcha Admin

# --- Stripe Payments (Phase 5) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Optional checkout endpoint rate limiting (defaults: 15 min window, 100 dev / 30 prod)
# CHECKOUT_RATE_LIMIT_WINDOW_MS=900000
# CHECKOUT_RATE_LIMIT_MAX=30

# --- ImgBB Image Hosting (Step 2A) ---
IMGBB_API_KEY=
MAX_UPLOAD_MB=5
# Optional upload endpoint rate limiting (defaults: 15 min window, 100 dev / 30 prod)
# UPLOAD_RATE_LIMIT_WINDOW_MS=900000
# UPLOAD_RATE_LIMIT_MAX=30
